+                'message' => $msg['message'],
+                'sent_at' => now()->subDays(rand(0, 5))->addMinutes($i * 7),
+                'communication_log_id' => $logId,
+                'created_at' => now(),
+                'updated_at' => now(),
+            ]);
+        }
+    }
